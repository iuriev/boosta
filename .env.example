# Copy to .env to override the defaults used by the docker-compose files.

POSTGRES_USER=boosta
POSTGRES_PASSWORD=boosta
POSTGRES_DB=boosta
# Host port of the development PostgreSQL (docker-compose.dev.yml).
# Change it when 5432 is already taken.
POSTGRES_PORT=5432

# Host ports of the full system (docker-compose.yml).
WEB_PORT=3000
API_PORT=3001

# Signs session cookies in docker-compose.yml. Set your own for anything but a local run.
# JWT_SECRET=
