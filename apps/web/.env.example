# Copy to .env.local for local development (pnpm dev:web).

# Where the Next.js server reaches the API. Browsers never call it directly:
# they use /api on this app's own origin, which is forwarded here.
API_URL=http://localhost:3001

# Set to true only when a load balancer or reverse proxy in front of this app
# sets X-Forwarded-For itself. Otherwise the header is whatever the browser
# sent and is not passed on to the API.
# TRUST_FORWARDED_HEADERS=false
