# Copy to .env for local development (pnpm --filter @boosta/api dev).

NODE_ENV=development
PORT=3001
# Matches docker-compose.dev.yml. Change the port if POSTGRES_PORT is overridden.
DATABASE_URL=postgresql://boosta:boosta@localhost:5432/boosta
# Signs session cookies; at least 32 characters. This placeholder is refused in
# production. Generate a real one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# The web app calls the API from this machine, so its X-Forwarded-For is trusted.
# Leave unset when clients reach the API directly.
TRUST_PROXY=loopback
# Optional, defaults shown.
# BCRYPT_ROUNDS=12
# Sign-in and registration requests per minute for one email from one client.
# AUTH_RATE_LIMIT_PER_MINUTE=10
