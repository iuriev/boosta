# Keep the build context small and free of local state.
**/node_modules
**/dist
**/.next
**/coverage
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
.git
.github
.husky
.claude
.tmp-figma
docs
openspec
*.md

# Tests are not part of the images, and must not be able to fail their build.
apps/web/e2e
apps/web/playwright.config.ts
apps/web/vitest.config.ts
apps/web/src/test
**/*.test.ts
**/*.test.tsx
